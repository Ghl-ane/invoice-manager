APP_NAME=InvoiceX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invoice_manager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync  → runs jobs in the same request (causes 30s timeout on Railway — DO NOT use in production)
# database → jobs stored in DB and processed by a queue worker (correct for Railway)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------
# MAIL — invoice delivery
# -----------------------------------------------------------------------
# Drivers: log | array | smtp | resend | mailgun | ses
#
# log   → writes to storage/logs/laravel.log (local dev, no email sent)
# array → captured in memory only (tests)
# smtp  → any SMTP provider (Mailtrap, Brevo, Gmail, etc.)
# resend → Resend.com HTTP API — fast, no SMTP timeout risk (recommended for Railway)
#
# Local dev — Mailtrap:
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<mailtrap-user>
#   MAIL_PASSWORD=<mailtrap-pass>
#
# Production (Railway) — Resend (https://resend.com, free tier: 100 emails/day):
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_xxxxxxxxxxxx
#   MAIL_FROM_ADDRESS=invoices@yourdomain.com   ← must be a verified domain in Resend
#
# ⚠  SMTP on Railway will cause a 30s timeout because the PHP socket blocks the
#    request. Always use QUEUE_CONNECTION=database + a queue worker so mail is
#    sent in the background, not in the HTTP request.
# -----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FreeCurrencyAPI — https://freecurrencyapi.com (free tier: 5,000 req/month)
# Leave blank to use static fallback rates from config/currencies.php
CURRENCY_API_KEY=
